# Copy to .env.local for `npm run dev`, or pass as --build-arg when building the image.
# Both are read at BUILD time by Vite and baked into the bundle — they are not secrets,
# and there is no secret here to leak: this is a PUBLIC OIDC client using PKCE.

# The realm proxy_alpha hosts. Leave empty to build a bundle that offers only the
# local break-glass account.
VITE_OIDC_ISSUER=http://192.168.194.129:8081/realms/aerotunnel

# A PUBLIC client on that realm, with this UI's callback in its redirect URIs and
# two protocol mappers, without which every token this server sees is refused:
#   - an audience mapper adding `aeroserver-admin` (Keycloak omits `aud` otherwise)
#   - a realm-roles mapper writing `realm_access.roles`
VITE_OIDC_CLIENT_ID=aeroserver-webui
